{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mycelium",
  "version": "2.6.0",
  "identifier": "com.mycelium.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run preparar-mcp -- --dev && npm run dev",
    "beforeBuildCommand": "npm run preparar-mcp && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mycelium",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": ["'self'", "'wasm-unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "https:", "data:", "blob:"],
        "font-src": ["'self'", "data:"],
        "media-src": ["'self'", "asset:", "http://asset.localhost", "blob:"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "asset:", "http://asset.localhost", "blob:", "data:"],
        "frame-src": ["'self'", "asset:", "http://asset.localhost", "https://www.youtube-nocookie.com", "https://www.youtube.com", "https://player.vimeo.com"],
        "worker-src": ["'self'", "blob:"],
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://pub-4a4b6d7b99be4917a2fe0074be9dfa40.r2.dev/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBOEIzRDJDNDczNkY2RDcKUldUWDlqWkhMRDJMYXMyUHUvRGJBeGNHeHNOSnZMcWZ0Zm1LVVppbHJTRVBaNDMyeE9ZaXdkTVgK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/mycelium-mcp"],
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown",
        "description": "Nota Markdown de Mycelium",
        "role": "Editor"
      },
      {
        "ext": ["excalidraw"],
        "name": "Excalidraw",
        "description": "Dibujo Excalidraw de Mycelium",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "wix": {
        "upgradeCode": "6e50c446-8815-5802-95d7-35ac80282d7f"
      }
    }
  }
}

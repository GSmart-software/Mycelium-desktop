{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "vault-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}

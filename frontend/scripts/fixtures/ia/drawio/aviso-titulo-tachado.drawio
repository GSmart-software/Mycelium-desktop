<mxfile host="Mycelium">
  <diagram id="arq" name="Arquitectura">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Capas: contenedores de 760 de ancho, 40 px de separación vertical entre ellas.
             Los hijos llevan x,y RELATIVAS al contenedor y empiezan debajo del encabezado (startSize=30). -->
        <mxCell id="capa-pres" value="Capa de presentación" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="760" height="130" as="geometry" />
        </mxCell>
        <mxCell id="web" value="Aplicación web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="capa-pres">
          <mxGeometry x="150" y="50" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="movil" value="App móvil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="capa-pres">
          <mxGeometry x="450" y="50" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="capa-serv" value="Capa de servicios" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="760" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pedidos" value="Servicio de pedidos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="capa-serv">
          <mxGeometry x="40" y="50" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="capa-serv">
          <mxGeometry x="300" y="50" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="usuarios" value="Servicio de usuarios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="capa-serv">
          <mxGeometry x="560" y="50" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="capa-datos" value="Capa de datos" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="760" height="150" as="geometry" />
        </mxCell>
        <mxCell id="bd-pedidos" value="BD pedidos&lt;br&gt;(PostgreSQL)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="capa-datos">
          <mxGeometry x="40" y="45" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="Caché&lt;br&gt;(Redis)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="capa-datos">
          <mxGeometry x="300" y="45" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bd-usuarios" value="BD usuarios&lt;br&gt;(PostgreSQL)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="capa-datos">
          <mxGeometry x="560" y="45" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Aristas entre capas: parent="1" (no el contenedor), así sus puntos son absolutos.
             Las dos que llegan al gateway entran por puntos distintos (0.3 y 0.7) para no encimarse. -->
        <mxCell id="e-web" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-movil" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="movil" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gw-pedidos" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="pedidos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gw-usuarios" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="usuarios">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-pedidos-bd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="pedidos" target="bd-pedidos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gw-cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="gateway" target="cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-usuarios-bd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="usuarios" target="bd-usuarios">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

<mxfile host="Mycelium">
  <diagram id="arbol" name="Estructura">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!--
          Cajas de distinto ancho por nivel. Ancho de cada subárbol:
            Contaduría 160 · Administración = max(220, 160) = 220
            Tecnología = max(160, 3×160 + 2×20) = 520
            Dirección  = max(200, 220 + 40 + 520) = 780
          Administración ocupa x 40…260: su hija va centrada debajo (x = 40 + (220−160)/2 = 70).
          Tecnología arranca 40 después (300): hojas en 300, 480, 660; centro 560 → x = 480.
          Dirección: centro (150 + 560) / 2 = 355 → x = 255.
        -->
        <mxCell id="dir" value="&lt;b&gt;Dirección general&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="255" y="40" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="adm" value="&lt;b&gt;Administración y finanzas&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tec" value="&lt;b&gt;Tecnología&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="480" y="160" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="conta" value="Contaduría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="280" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="back" value="Backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="front" value="Frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="480" y="280" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="infra" value="Infraestructura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="660" y="280" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-dir-adm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dir" target="adm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-dir-tec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dir" target="tec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-adm-conta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm" target="conta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-tec-back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tec" target="back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-tec-front" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tec" target="front">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-tec-infra" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tec" target="infra">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

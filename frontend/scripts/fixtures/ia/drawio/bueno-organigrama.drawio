        <mxCell id="ceo" value="&lt;b&gt;Marta Ríos&lt;/b&gt;&lt;br&gt;Directora general" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="690" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- Nivel 1 (y=160): cada gerente centrado sobre el tramo que ocupan sus hojas -->

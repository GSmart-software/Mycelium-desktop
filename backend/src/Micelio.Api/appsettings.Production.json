{
  "_comment": "Plantilla de producción (modo Cloudflare). Los valores reales y TODOS los secretos se inyectan como variables de entorno en Render (notacion doble guion bajo, p.ej. Cloudflare__ApiToken, Jwt__Secret). NO commitear secretos aqui.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "Provider": "cloudflare"
  },
  "Cloudflare": {
    "AccountId": "REEMPLAZAR_O_VIA_ENV_Cloudflare__AccountId",
    "ApiToken": "VIA_ENV_Cloudflare__ApiToken",
    "D1": {
      "DatabaseId": "REEMPLAZAR_O_VIA_ENV_Cloudflare__D1__DatabaseId"
    },
    "R2": {
      "Bucket": "micelio-blobs",
      "AccessKeyId": "VIA_ENV_Cloudflare__R2__AccessKeyId",
      "SecretAccessKey": "VIA_ENV_Cloudflare__R2__SecretAccessKey"
    }
  },
  "Jwt": {
    "Issuer": "micelio",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "FrontendOrigin": "https://REEMPLAZAR.pages.dev"
  },
  "Auth": {
    "CookieSameSite": "None",
    "CookieSecure": true
  }
}
